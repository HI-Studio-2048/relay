# Postgres (Railway/docker). If omitted locally, Relay uses file-backed PGlite in .data/
DATABASE_URL=postgres://relay:relay@localhost:5432/relay

# Redis (Railway/docker). If omitted locally, Relay uses an in-memory queue + rate limiter.
REDIS_URL=redis://localhost:6379

# 32-byte key: 64 hex chars, or base64, or 32-char utf8. Required in production.
ENCRYPTION_KEY=replace-with-64-hex-chars-or-32-byte-key

# Public HTTPS origin used when setting the Telegram webhook.
# Example: https://relay-production.up.railway.app
PUBLIC_URL=
# Shown on /privacy, /terms and /data-deletion. Platform API reviews check it.
PUBLIC_CONTACT_EMAIL=

# Connected apps (Channels page, Connected apps). Each pair turns its Connect button on.
# Register this redirect URL with the provider: <PUBLIC_URL>/api/connections/<google|tiktok>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Add to Slack: one Slack app owned by the company, installed by each customer's workspace.
# Create it from slack-app-manifest.json. All three are needed for the button to appear.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# Add to Discord: one Discord app and bot owned by the company, added to each customer's server.
# DISCORD_CLIENT_ID is the application id. Redirect URL to register: <PUBLIC_URL>/api/discord/oauth/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=

# Sign in with Bluesky: the private signing key Recatch proves itself with (one line of JSON).
# Make it once with: node scripts/bluesky-keygen.mjs   PUBLIC_URL must be https.
BLUESKY_OAUTH_KEY=

# Signs login session cookies. Falls back to ENCRYPTION_KEY; one of them is required in production.
SESSION_SECRET=

# Workspace owner, created on first boot if missing. Channel accounts and team members that existed
# before logins are assigned to this user. Changing the password here later does not reset it.
RELAY_OWNER_EMAIL=
RELAY_OWNER_PASSWORD=
RELAY_OWNER_NAME=

# Optional Telegram chat id that also receives team alerts (Notify admin steps, hand-offs).
# Slack / Discord / Teams alerts are configured per account in Settings → Team alerts.
ADMIN_TELEGRAM_CHAT_ID=

# web | worker | all  (v1 default is all — one Railway service)
WORKER_MODE=all

# Telegram send budget per bot (do not raise to spam)
TELEGRAM_SENDS_PER_SECOND=20

# Optional directory for uploaded flow images/GIFs. Default: .data/media
# Uploads live in the database now. This is only read for old files saved on disk.
MEDIA_DIR=

# Claude API key for AI Steps, AI auto-reply, Live Chat suggestions and the AI flow builder.
ANTHROPIC_API_KEY=


# Zernio carries Instagram, Messenger and WhatsApp for every customer. Both needed; without them the Meta
# connect buttons fall back to pasting a token. ZERNIO_WEBHOOK_SECRET is the signing secret of the one webhook
# registered in Zernio (URL: PUBLIC_URL/api/zernio/webhook).
ZERNIO_API_KEY=
ZERNIO_WEBHOOK_SECRET=

# Amazon SES for password reset, welcome and hand-off emails. All four needed; without them email is off.
# EMAIL_FROM must be an address or domain verified in SES. Region example: us-east-1.
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_REGION=
EMAIL_FROM=
# Optional: EMAIL_REPLY_TO, AWS_SES_SESSION_TOKEN (temporary credentials only)
# The SNS topic SES sends bounce and complaint notices to. /api/email/feedback only accepts this topic.
AWS_SES_SNS_TOPIC_ARN=
